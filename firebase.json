{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": "out",
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {
        "source": "/ws/**",
        "run": {
          "serviceId": "spatial-eye",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/**",
        "run": {
          "serviceId": "spatial-eye",
          "region": "us-central1"
        }
      },
      {
        "source": "/diagnostics/**",
        "run": {
          "serviceId": "spatial-eye",
          "region": "us-central1"
        }
      }
    ]
  }
}
